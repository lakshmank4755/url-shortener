{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Storage": {
    "DataDirectory": "data"
  },
  "UrlSafety": {
    "OwnHostNames": [ "localhost", "localhost:5000", "localhost:5080", "short.ly" ],
    "BlockedHostNames": [ "known-malware-example.test", "phishing-example.test" ]
  }
}
